/*!
 * \file tile_graph.def
 * \brief
 */

DEFOP(
    UnaryOp,
    INHERIT(ElementWiseUnaryTileBaseOp),
    OPCODE(
        OP_EXP,
        OP_NEG,
        OP_RSQRT,
        OP_SQRT,
        OP_LOGICALNOT,
        OP_RECIPROCAL,
        OP_ABS,
        OP_LN
    ),
    ATTR(int, CombineAxis)
)

DEFOP(
    BinaryOp,
    INHERIT(ElementWiseBinaryTileBaseOp),
    OPCODE(
        OP_ADD,
        OP_SUB,
        OP_MUL,
        OP_DIV,
        OP_MIN,
        OP_MAX
    ),
    ATTR(int, CombineAxis)
)

DEFOP(
    BinaryScalarMixOp,
    INHERIT(ElementWiseScalarMixBinaryTileBaseOp),
    OPCODE(
        OP_ADD_S,
        OP_SUB_S,
        OP_MUL_S,
        OP_DIV_S,
        OP_MIN_S,
        OP_MAX_S
    ),
    ATTR(int, CombineAxis),
    ATTR(int, Reverse),
)

DEF_OP(
    TernaryOp,
    INHERIT(ElementWiseTernaryTileOp),
    OPCODE(
        OP_WHERE_TT

    ),
    ATTR(int, WhereBitMode)
)

DEF_OP(
    TernaryScalarMixOp,
    INHERIT(ElementWiseScalarMixTernaryTileOp),
    OPCODE(
        OP_WHERE_TS,
        OP_WHERE_ST,
        OP_WHERE_SS,
        OP_INDEX_ADD, // 输入是三个tensor  两个 scalar  无额外属性
    ),
    ATTR(int, WhereBitMode),
)

DEF_OP(
    MoveOp,
    INHERIT(DataCopyTileOp),
    OPCODE(
        OP_INDEX_OUTCAST, // 输入是三个tensor，三个scalar  无额外属性
        OP_CONVERT,
        OP_COPY_IN,
        OP_COPY_OUT,
        OP_LOAD,
        OP_VLD,  //  只有注册的一行
        OP_VST,  //  只有注册的一行
        OP_DUPLICATE,  // duplicate会转化为copyout
    ),
)

DEF_OP(
    ExperimentOp,
    INHERIT(DataCopyTileOp),   // 存疑
    OPCODE(
        OP_GATHER_IN_L1,
        OP_GATHER_IN_UB,
    ),
    ATTR(int, startOffset) // OP_GATHER_IN_L1
)


DEF_OP(
    SortOp,
    INHERIT(SortTileOp),
    OPCODE(
        OP_BITSORT,
        OP_MRGSORT,
        OP_ARGSORT,
        OP_TILEDMRGSORT,
        OP_EXTRACT
    ),
    ATTR(int, TopOffset),  // OP_BITSORT
    ATTR(int, TopKValidBit)  // OP_TILEDMRGSORT
    ATTR(int, ExtractMaskMode)  // OP_EXTRACT
)

DEF_OP(
    TopKOp,
    INHERIT(SortTileOp),
    OPCODE(
        OP_TOPK
    ),
)

DEF_OP(
    BroadCastOp,
    INHERIT(BroadcastTileOp),
    OPCODE(
        OP_FUSED_OP  // 没有代码，注册的是BROADCAST
    ),
)


//   下面是姜昊的


DEF_OP(
    UnaryOp,
    INHERIT(ElementWiseUnaryTileOp),
    OPCODE(
        OP_EXP,
        OP_TRANSPOSE_MOVEIN,
        OP_TRANSPOSE_MOVEOUT,
        OP_TRANSPOSE_VNCHWCONV,
        OP_EXPAND,
        OP_ONEHOT,
        OP_CONCAT,
        OP_COMPACT,
        OP_ROWMAX,
        OP_ROWSUM,
        OP_ROWEXPMAX,
        OP_ROWEXPSUM,
        OP_REGISTER_COPY
    ),
    ATTR(std::vector<int64_t>, shape),          // 形状信息，用于TRANSPOSE系列
    ATTR(int, EXPANDDIM),                        // 扩展维度，用于OP_EXPAND
    ATTR(int, numClasses),                       // 类别数，用于OP_ONEHOT
    ATTR(int, inputCombineAxis),                 // 输入合并轴，用于OP_CONCAT
    ATTR(int, outputCombineAxis),                // 输出合并轴，用于OP_CONCAT
    ATTR(bool, excludeBufferReuse)               // 是否排除buffer复用，用于TRANSPOSE_VNCHWCONV/ONEHOT/ROWMAX/ROWEXPMAX/ROWEXPSUM
)

DEF_OP(
    BinaryOp,
    INHERIT(ElementWiseBinaryTileOp),
    OPCODE(
        OP_PAD
    ),
    ATTR(int, inputCombineAxis),                 // 输入合并轴
    ATTR(int, outputCombineAxis)                 // 输出合并轴
)

DEF_OP(
    BinaryBroadcastOp,
    INHERIT(BroadcastBinaryTileOp),
    OPCODE(
        OP_ADD_BRC,
        OP_SUB_BRC,
        OP_MUL_BRC,
        OP_DIV_BRC,
        OP_MAX_BRC,
        OP_MIN_BRC
    ),
    ATTR(int, inputCombineAxis)                  // 输入合并轴
)

DEF_OP(
    PowOp,
    INHERIT(ElementWiseMixTileOp),
    OPCODE(
        OP_POW
    ),
    ATTR(bool, reverseOperand),                  // 是否反转操作数顺序（与Reverse语义一致，重复）
    ATTR(int, inputCombineAxis),                 // 输入合并轴
    ATTR(int, outputCombineAxis),                // 输出合并轴
    ATTR(bool, excludeBufferReuse)               // 是否排除buffer复用
)

DEF_OP(
    GatherOp,
    INHERIT(GatherTileOp),
    OPCODE(
        OP_GATHER_FROM_UB,
        OP_GATHER,
        OP_GATHER_ELEMENT
    ),
    ATTR(int, axis),                             // 操作的轴
    ATTR(bool, excludeBufferReuse)               // 是否排除buffer复用（GATHER_FROM_UB/GATHER_ELEMENT使用）
)

enum class CmpOperationType {
    EQ,
    NE,
    LT,
    LE,
    GT,
    GE,
};
enum class CmpModeType {
    BOOL,
    BIT,
};

DEF_OP(
    CompareOp,
    INHERIT(CompareTileOp),
    OPCODE(
        OP_CMP,
        OP_CMPS
    ),
    ATTR(CmpOperationType, cmp_operation),           // 【枚举】比较操作类型
    ATTR(CmpModeType, cmp_mode),                     // 【枚举】比较模式
)

