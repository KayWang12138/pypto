enum class CmpOperationType {
    EQ,
    NE,
    LT,
    LE,
    GT,
    GE,
};
enum class CmpModeType {
    BOOL,
    BIT,
};

DEF_OP(
    CompareOp,
    INHERIT(CompareTileBaseOp),
    OPCODE(
        OP_CMP,
    ),
    INPUT(Tile, Input1),
    INPUT(Tile, Input2),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor),
    ATTR(CmpOperationType, CmpOperation),
    ATTR(CmpModeType, CmpMode)
)

DEF_OP(
    CompareScalarOp,
    INHERIT(CompareScalarTileBaseOp),
    OPCODE(
        OP_CMPS
    ),
    INPUT(Tile, Input1),
    INPUT(Scalar, Input2),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor),
    ATTR(CmpOperationType, CmpOperation),
    ATTR(CmpModeType, CmpMode)
)