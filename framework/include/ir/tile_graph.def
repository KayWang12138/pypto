DEF_OP(
    BinaryOp,
    INHERIT(ElementWiseBinaryTileBaseOp),
    OPCODE(
        OP_ADD,
        OP_SUB,
        OP_MUL,
        OP_DIV,
        OP_MIN,
        OP_MAX,
        OP_S_ADD,
        OP_S_SUB,
        OP_S_MUL,
        OP_S_DIV,
        OP_S_MAX,
        OP_S_MIN,
        OP_PAD
    ),
    INPUT(Tile, Lhs),
    INPUT(Tile, Rhs),
    OUTPUT(Tile, Output),
    ATTR(int, CombineAxis, -1),
    ATTR(bool, ReverseOperand, false)
)

DEF_OP(
    BinaryWithTempOp,
    INHERIT(ElementWiseBinaryWithTempTileBaseOp),
