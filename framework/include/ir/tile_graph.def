// 问题1：  输入有 MemoryType::MEM_DEVICE_DDR， MemoryType::MEM_UB， MemoryType::MEM_L1，需要感知吗？
// 问题2：  MTE类的opcode 没有和接口绑定，后续对齐有特殊性吗？




enum CastMode {
    CAST_NONE = 0,
    CAST_RINT = 1,  // round to nearest, tie to even
    CAST_ROUND = 2, // round to nearest, tie away from zero
    CAST_FLOOR = 3, // round to minus infinity
    CAST_CEIL = 4,  // round to positive infinity
    CAST_TRUNC = 5, // round to zero
    CAST_ODD = 6   // round to odd (Von Neumann rounding)
};

DEF_OP(
    UnaryOp,
    INHERIT(ElementWiseUnaryTileBaseOp),
    OPCODE(
        OP_EXP,
        OP_NEG,
        OP_RSQRT,
        OP_SQRT,
        OP_LOGICALNOT,
        OP_RECIPROCAL,
        OP_ABS,
        OP_LN,
 	    OP_COMPACT
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
    ATTR(int, CombineAxis)
)

DEF_OP(
    LogicalNotOp,
    INHERIT(ElementWiseUnaryTileBaseOp),
    OPCODE(
        OP_LOGICALNOT
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor),
    ATTR(int, CombineAxis)
)

DEF_OP(
    ExpandOp,
    INHERIT(ExpandTileBaseOp),
    OPCODE(
 	    OP_EXPAND
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
 	ATTR(int, EXPANDDIM)                      // 扩展维度，用于OP_EXPAND
)

DEF_OP(
    TransposeOp,
    INHERIT(TransposeTileBaseOp),
    OPCODE(
        OP_TRANSPOSE_MOVEIN,
 	    OP_TRANSPOSE_MOVEOUT,
 	    OP_TRANSPOSE_VNCHWCONV
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
    ATTR(std::vector<int64_t>, shape),          // 形状信息，用于TRANSPOSE系列
 	ATTR(bool, excludeBufferReuse)               // 是否排除buffer复用，用于TRANSPOSE_VNCHWCONV/ONEHOT/ROWMAX/ROWEXPMAX/ROWEXPSUM
)

DEF_OP(
    OnehotOp,
    INHERIT(OnehotTileBaseOp),
    OPCODE(
 	    OP_ONEHOT
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
 	ATTR(int, numClasses)                       // 类别数，用于OP_ONEHOT
)

DEF_OP(
    CastOp,
    INHERIT(CastTileBaseOp),
    OPCODE(
        OP_CAST
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
    ATTR(int, CombineAxis, -1),
    ATTR(CastMode, Mode)
)

DEF_OP(
    RangeOp,
    INHERIT(RangeTileBaseOp),
    OPCODE(
        OP_RANGE
    ),
    INPUT(Scalar, START),
    INPUT(Scalar, STEP),
    INPUT(Scalar, Size),
    OUTPUT(Tile, Output),
    ATTR(int, CombineAxis)
)

DEF_OP(
    CumSumOp,
    INHERIT(CumSumTileBaseOp),
    OPCODE(
        OP_CUM_SUM
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
    INPUT(Scalar, Axis),
    ATTR(int, CombineAxis),
    ATTR(bool, Flag)
)

DEF_OP(
    BinaryOp,
    INHERIT(ElementWiseBinaryTileBaseOp),
    OPCODE(
        OP_ADD,
        OP_SUB,
        OP_MUL,
        OP_DIV,
        OP_MIN,
        OP_MAX,
        OP_S_ADD,
        OP_S_SUB,
        OP_S_MUL,
        OP_S_DIV,
        OP_S_MAX,
        OP_S_MIN,
        OP_LOGICALAND,
        OP_PAD
    ),
    INPUT(Tile, Lhs),
    INPUT(Tile, Rhs),
    OUTPUT(Tile, Output),
    ATTR(int, CombineAxis, -1),
    ATTR(bool, ReverseOperand, false),
    ATTR(int, InputCombineAxis),                 // 输入合并轴
 	ATTR(int, OutputCombineAxis)                 // 输出合并轴
)

DEF_OP(
    BinaryOp,
    INHERIT(ElementWiseBinaryTileBaseOp),
    OPCODE(
        OP_LOGICALAND
    ),
    INPUT(Tile, Lhs),
    INPUT(Tile, Rhs),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor),
    ATTR(int, CombineAxis, -1),
    ATTR(bool, ReverseOperand, false),
    ATTR(int, InputCombineAxis),                 // 输入合并轴
 	ATTR(int, OutputCombineAxis)                 // 输出合并轴
)

DEF_OP(
    ScatterElementsOp,
    INHERIT(ScatetrElementsTileBaseOp),
    OPCODE(
        OP_SCATTER_ELEMENT
    ),
    INPUT(Tile, Src0),
    INPUT(Tile, Src1),
    INPUT(Scalar, scatter),
    OUTPUT(Tile, Output),
    ATTR(int, CombineAxis),
    ATTR(int, Axis),    // scatterelements/scatter 指定轴
    ATTR(int, ScatterMode),  // scatterelements/scatter reduce 类型
    ATTR(int, Accumulate)   // index put 是否累加
)

DEF_OP(
    ScatterOp,
    INHERIT(ScatetrTileBaseOp),
    OPCODE(
        OP_SCATTER
    ),
    INPUT(Tile, Src0),
    INPUT(Tile, Src1),
    INPUT(Tile, Src2),
    OUTPUT(Tile, Output),   // todo tileop 实现 output 与 Src0 共内存
    ATTR(int, CombineAxis),
    ATTR(int, Axis),    //  指定轴
    ATTR(int, ScatterMode),  // reduce 类型
    ATTR(int, Accumulate)   // index put 是否累加
)

DEF_OP(
    IndexPutOp,      // 没有对应的TileOp，OP_INDEX_PUT实际使用scatter update
    OPCODE(
        OP_INDEX_PUT
    ),
)

DEF_OP(
    BinaryScalarMixOp,
    INHERIT(ElementWiseScalarMixBinaryTileBaseOp),
    OPCODE(
        OP_ADDS,
        OP_SUBS,
        OP_MULS,
        OP_DIVS,
        OP_MINS,
        OP_MAXS,
        OP_S_ADDS,
        OP_S_SUBS,
        OP_S_MULS,
        OP_S_DIVS,
        OP_S_MAXS,
        OP_S_MINS
        
    ),
    INPUT(Tile, Lhs),
    INPUT(Scalar, Rhs),
    OUTPUT(Tile, Output),
    ATTR(int, CombineAxis, -1),
    ATTR(bool, ReverseOperand, false)
)

DEF_OP(
    PowOp,
    INHERIT(PowTileBaseOp),
    OPCODE(
        OP_POW
    ),
    INPUT(Tile, Lhs),
    INPUT(Scalar, Rhs),
    OUTPUT(Tile, Output),
    ATTR(int, InputCombineAxis),                 // 输入合并轴
 	ATTR(int, OutputCombineAxis),                // 输出合并轴
 	ATTR(bool, ExcludeBufferReuse)               // 是否排除buffer复用
)

DEF_OP(
    GatherOp,
    INHERIT(GatherTileBaseOp),
    OPCODE(
        OP_GATHER_FROM_UB,
        OP_GATHER,
        OP_GATHER_ELEMENT
    ),
    INPUT(Tile, Lhs),
    INPUT(Tile, Rhs),
    OUTPUT(Tile, Output),
    ATTR(int, Axis),                             // 操作的轴
    ATTR(bool, ExcludeBufferReuse)               // 是否排除buffer复用（GATHER_FROM_UB/GATHER_ELEMENT使用）
)

DEF_OP(
    BroadcastOp,
    INHERIT(BroadcastTileBaseOp),
    OPCODE(
        OP_MAXIMUM,
        OP_MINIMUM,
        OP_PAIRMAX,
        OP_PAIRMIN,
        OP_PAIRSUM
    ),
    INPUT(Tile, Lhs),
    INPUT(Tile, Rhs),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor),
    ATTR(int, CombineAxis)
)


DEF_OP(
    FusedOp,
    INHERIT(BroadcastTileBaseOp),
    OPCODE(
        OP_FUSED_OP
    ),
    INPUT(Tile, Lhs),
    INPUT(Tile, Rhs),
    OUTPUT(Tile, Output)
)


DEF_OP(
    ReduceSingleOp,
    INHERIT(ReduceTileBaseOp),
    OPCODE(
        OP_ROWMAX_SINGLE,
        OP_ROWMIN_SINGLE,
        OP_ROWSUM_SINGLE,
        OP_ROWSUMLINE
        OP_ROWMAXLINE,
        OP_ROWMINLINE,
        OP_ROWMAX,      //暂定无法确认是否有实现
 	    OP_ROWSUM,      //暂定无法确认是否有实现
 	    OP_ROWEXPMAX,   //暂定无法确认是否有实现 
 	    OP_ROWEXPSUM   //暂定无法确认是否有实现  
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor),
    ATTR(int, Axis)
)

DEF_OP(
    ReduceLineOp,
    INHERIT(ReduceTileBaseOp),
    OPCODE(
        OP_ROWMAXLINE,
        OP_ROWMINLINE
    ),
    INPUT(Tile, Input),
    OUTPUT(Tile, Output),
    ATTR(int, Axis)
)

DEF_OP(
    MoveOp,
    INHERIT(DataCopyTileBaseOp),
    OPCODE(
 	    OP_CONVERT,
 	    OP_COPY_IN,
 	    OP_COPY_OUT,
 	    OP_VLD,  //  只有注册的一行
 	    OP_VST,  //  只有注册的一行
 	    OP_DUPLICATE  // duplicate会转化为copyout
    ),
    INPUT(Tile, Lhs),
    OUTPUT(Tile, Output),
    ATTR(int, inputCombineAxis),   // OP_COPY_OUT
    ATTR(int, outputCombineAxis),  // OP_COPY_IN
    ATTR(int, excludeBufferReuse)  // OP_COPY_IN, OP_COPY_OUT
)

DEF_OP(
    LoadOp,
    INHERIT(DataCopyTileBaseOp),
    OPCODE(
 	    OP_LOAD
    ),
    INPUT(Tile, Lhs),
    INPUT(Tile, Rhs),
    OUTPUT(Tile, Output)
)

DEF_OP(
    IndexOp,
    INHERIT(DataCopyTileBaseOp),
    OPCODE(
        OP_INDEX_OUTCAST // 输入是三个tensor，三个scalar  无额外属性
        
    ),
    INPUT(Tile, Src),
    INPUT(Tile, Index),
    INPUT(Tile, Dst),
    INPUT(Scalar, Axis),
    INPUT(Scalar, PanzBlockSize),
    INPUT(Scalar, CacheMode),
    OUTPUT(Tile, Output)
)

DEF_OP(
    UBMoveOp,
    INHERIT(DataCopyTileBaseOp),
    OPCODE(
        OP_UB_COPY_IN,
        OP_UB_COPY_OUT
    ),
    INPUT(Tile, Lhs),
    INPUT(Tile, Rhs),
    OUTPUT(Tile, Output),
    ATTR(int, ExcludeBufferReuse)  // OP_UB_COPY_IN, OP_UB_COPY_OUT
)

DEF_OP(
    TopKOp,
    INHERIT(SortTileBaseOp),
    OPCODE(
        OP_TOPK
    ),
    INPUT(Tile, Lhs),
    INPUT(Scalar, Axis),
    INPUT(Scalar, KValue),
    INPUT(Scalar, Order),
    OUTPUT(Tile, Output1),
    OUTPUT(Tile, Output2)

)

DEF_OP(
 	SortOp,
 	INHERIT(SortTileBaseOp),
 	OPCODE(
 	    OP_BITSORT,
 	    OP_MRGSORT,
 	    OP_ARGSORT,
 	    OP_EXTRACT
 	),
    INPUT(Tile, Lhs),
    OUTPUT(Tile, Output),
 	ATTR(int, TopOffset),  // OP_BITSORT
 	ATTR(int, ExtractMaskMode)  // OP_EXTRACT
)

DEF_OP(
 	TileSortOp,
 	INHERIT(SortTileBaseOp),
 	OPCODE(
 	    OP_TILEDMRGSORT
 	),
    INPUT(Tile, input1),
    INPUT(Tile, input2),
    INPUT(Tile, input3),
    INPUT(Tile, input4),
    INPUT(Scalar, KValue),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, Temp),
 	ATTR(int, TopKValidBit)  // OP_TILEDMRGSORT
)

DEF_OP(
 	ExperimentOp,
 	INHERIT(DataCopyTileBaseOp),   // 存疑
 	OPCODE(
 	    OP_GATHER_IN_L1,
 	    OP_GATHER_IN_UB
 	),
    INPUT(Tile, input1),
    INPUT(Tile, input2),
    INPUT(Tile, input3),
    OUTPUT(Tile, Output),
 	ATTR(int, StartOffset) // OP_GATHER_IN_L1
)

DEF_OP(
 	TernaryOp,
 	INHERIT(ElementWiseTernaryTileBaseOp),
 	OPCODE(
 	    OP_WHERE_TT
 	),
    INPUT(Tile, Condition),
    INPUT(Tile, Input),
    INPUT(Tile, Other),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor)
)
 	 
DEF_OP(
    WhereSTOp,
    INHERIT(ElementWiseScalarMixTernaryTileBaseOp),
    OPCODE(
        OP_WHERE_ST          // 与TS输入顺序不同
    ),
    INPUT(Tile, Condition),
    INPUT(Scalar, Input),
    INPUT(Tile, Other),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor)
)

DEF_OP(
    WhereTSOp,
    INHERIT(ElementWiseScalarMixTernaryTileBaseOp),
    OPCODE(
        OP_WHERE_TS
    ),
    INPUT(Tile, Condition),
    INPUT(Tile, Input),
    INPUT(Scalar, Other),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor)
)

DEF_OP(
    WhereSSOp,
    INHERIT(ElementWiseScalarMixTernaryTileBaseOp),
    OPCODE(
        OP_WHERE_SS
    ),
    INPUT(Tile, Condition),
    INPUT(Scalar, Input),
    INPUT(Scalar, Other),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor)
)

DEF_OP(
    IndexAddOp,
    INHERIT(ElementWiseScalarMixTernaryTileBaseOp),    //  存疑
    OPCODE(
        OP_INDEX_ADD
    ),
    INPUT(Tile, input1),
    INPUT(Tile, input2),
    INPUT(Tile, input3),
    INPUT(Scalar, Axis),
    INPUT(Scalar, Alpha),
    OUTPUT(Tile, Output)
)

enum class CmpOperationType {
    EQ,
    NE,
    LT,
    LE,
    GT,
    GE,
};
enum class CmpModeType {
    BOOL,
    BIT,
};

DEF_OP(
    CompareOp,
    INHERIT(CompareTileBaseOp),
    OPCODE(
        OP_CMP,
    ),
    INPUT(Tile, input1),
    INPUT(Tile, input2),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor),
    ATTR(CmpOperationType, CmpOperation),           // 【枚举】比较操作类型
    ATTR(CmpModeType, CmpMode)                   // 【枚举】比较模式
)

DEF_OP(
    CompareScalarOp,
    INHERIT(CompareScalarTileBaseOp),
    OPCODE(
        OP_CMPS
    ),
    INPUT(Tile, input1),
    INPUT(Scalar, input2),
    OUTPUT(Tile, Output),
    OUTPUT(Tile, TempTensor),
    ATTR(CmpOperationType, CmpOperation),           // 【枚举】比较操作类型
    ATTR(CmpModeType, CmpMode)                   // 【枚举】比较模式
)