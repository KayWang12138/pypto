{
  "op_name": "{op}",
  "source": "pypto-op-develop",
  "description": "PyPTO {op} 算子测试用例",

  "_input_format_notes": {
    "single_input": "input: {shape: [...], dtype: '...'} — 单输入算子",
    "multi_input": "input: {param1: {shape: [...], dtype: '...'}, param2: ...} — 多输入算子，按参数名取 shape"
  },

  "test_cases": [
    {
      "id": "level0",
      "description": "单输入 — 小数据量基础功能验证",
      "seed": 0,
      "input": {
        "shape": [1, 16],
        "dtype": "float32"
      },
      "output": {
        "shape": [1, 16],
        "dtype": "float32"
      },
      "rtol": 1e-3,
      "atol": 1e-3
    },
    {
      "id": "level1",
      "description": "单输入 — 典型场景验证",
      "seed": 42,
      "input": {
        "shape": [4, 1024],
        "dtype": "float32"
      },
      "output": {
        "shape": [4, 1024],
        "dtype": "float32"
      },
      "rtol": 1e-3,
      "atol": 1e-3
    },
    {
      "id": "multi_input_example",
      "description": "多输入 — RMSNorm 示例 (hidden_states + weight)",
      "seed": 42,
      "input": {
        "hidden_states": {"shape": [1, 2048], "dtype": "float16"},
        "weight": {"shape": [2048], "dtype": "float16"}
      },
      "output": {
        "shape": [1, 2048],
        "dtype": "float16"
      },
      "rtol": 1e-2,
      "atol": 1e-2
    }
  ]
}