# Example 13: Flash Attention (FA)
# Efficient attention computation with block-wise processing
# Simplified version demonstrating block-wise attention computation
program.module @main {
  program.entry @flash_attention
  attr arch = "PTOv2"
  attr enable_debug = true
  attr tile_default = { M=16, N=16, K=16 }
  func.func @flash_attention(%query: tensor<[%b_1, %seq_len, %d_model], fp32>, %key: tensor<[%b_1, %seq_len, %d_model], fp32>, %value: tensor<[%b_1, %seq_len, %d_model], fp32>, %scale: fp32, %output: tensor<[%b_1, %seq_len, %d_model], fp32>) {
    // Process in blocks
    %acc_output = statement.for %i = %const_0 to %seq_len step %block_size
                iter_args(%acc = %output : tensor<[%b_1, %seq_len, %d_model], fp32>)
    {
        statement.op {
            // Load query block
            %q_block = tensor.view %query : (tensor<[%b_1, %seq_len, %d_model], fp32>) -> tensor<[%b_1, %block_size, %d_model], fp32> {shape=[%b_1, %block_size, %d_model], offset=[0, %i, 0]}
            // Load key block
            %k_block = tensor.view %key : (tensor<[%b_1, %seq_len, %d_model], fp32>) -> tensor<[%b_1, %block_size, %d_model], fp32> {shape=[%b_1, %block_size, %d_model], offset=[0, %i, 0]}
            // Load value block
            %v_block = tensor.view %value : (tensor<[%b_1, %seq_len, %d_model], fp32>) -> tensor<[%b_1, %block_size, %d_model], fp32> {shape=[%b_1, %block_size, %d_model], offset=[0, %i, 0]}
            // Compute scores: Q @ K^T
            %k_transpose = tensor.view %k_block : (tensor<[%b_1, %block_size, %d_model], fp32>) -> tensor<[%b_1, %d_model, %block_size], fp32>
            %scores = tensor.mul %q_block, %k_transpose : (tensor<[%b_1, %block_size, %d_model], fp32>, tensor<[%b_1, %d_model, %block_size], fp32>) -> tensor<[%b_1, %block_size, %block_size], fp32>
            // Scale scores
            %scaled_scores = tensor.mul %scores, %scale : (tensor<[%b_1, %block_size, %block_size], fp32>, %scale) -> tensor<[%b_1, %block_size, %block_size], fp32>
            // Apply exp for attention weights
            %exp_scores = tensor.exp %scaled_scores : (tensor<[%b_1, %block_size, %block_size], fp32>) -> tensor<[%b_1, %block_size, %block_size], fp32>
            // Compute attention output: exp_scores @ V
            %attn_output = tensor.mul %exp_scores, %v_block : (tensor<[%b_1, %block_size, %block_size], fp32>, tensor<[%b_1, %block_size, %d_model], fp32>) -> tensor<[%b_1, %block_size, %d_model], fp32>
            // Update accumulator
            %acc_updated = tensor.assemble %attn_output, %acc : (tensor<[%b_1, %block_size, %d_model], fp32>, tensor<[%b_1, %seq_len, %d_model], fp32>) -> tensor<[%b_1, %seq_len, %d_model], fp32> {offset=[0, %i, 0]}
        }
        statement.yield %acc_updated
    }
    statement.op {
        %output_result = tensor.assemble %acc_output, %output : (tensor<[%b_1, %seq_len, %d_model], fp32>, tensor<[%b_1, %seq_len, %d_model], fp32>) -> tensor<[%b_1, %seq_len, %d_model], fp32> {offset=[0, 0, 0]}
    }
    statement.return
  }
  // func.kind = control_flow
}
