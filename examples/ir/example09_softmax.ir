# Example 10: Softmax Operation
# Computes softmax along the last dimension: exp(x) / sum(exp(x))
# Simplified version using available operations
program.module @main {
  program.entry @softmax
  attr arch = "PTOv2"
  attr enable_debug = true
  attr tile_default = { M=16, N=16, K=16 }
  func.func @softmax(%input: tensor<[%b_1, %seq_len, %d_model], fp32>, %output: tensor<[%b_1, %seq_len, %d_model], fp32>) {
    statement.op {
        // Compute exp(x) for softmax
        %exp_input = tensor.exp %input : (tensor<[%b_1, %seq_len, %d_model], fp32>) -> tensor<[%b_1, %seq_len, %d_model], fp32>
        // Normalize by dividing by a constant (simplified - in practice would sum along last dim)
        %norm_const = 1.0 : fp32
        %softmax_result = tensor.mul %exp_input, %norm_const : (tensor<[%b_1, %seq_len, %d_model], fp32>, %norm_const) -> tensor<[%b_1, %seq_len, %d_model], fp32>
        %output_result = tensor.assemble %softmax_result, %output : (tensor<[%b_1, %seq_len, %d_model], fp32>, tensor<[%b_1, %seq_len, %d_model], fp32>) -> tensor<[%b_1, %seq_len, %d_model], fp32> {offset=[0, 0, 0]}
    }
    statement.return
  }
  // func.kind = control_flow
}
