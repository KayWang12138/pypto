# Example 9: Scalar Operations
# Demonstrates scalar operations and return values
program.module @test_scalar_ops {
  program.entry @test_scalar
  attr arch = "PTOv2"
  attr enable_debug = true
  attr tile_default = { M=16, N=16, K=16 }
  func.func @test_scalar(%input: tensor<[%b_1, 128], fp32>, %scale: fp32) -> (fp64) {
    statement.op {
        # Scalar constants
        %scalar1 = 10.5 : fp64
        %scalar2 = 5.2 : fp64
        %const_2 = 2.0 : fp64
        
        # Scalar operations
        %scalar_add = tensor.OP_SCALAR_ADD %scalar1, %scalar2 : (fp64, fp64) -> fp64
        %scalar_mul = tensor.OP_SCALAR_MUL %scalar_add, %const_2 : (fp64, fp64) -> fp64
        %scalar_sub = tensor.OP_SCALAR_SUB %scalar_mul, %scalar1 : (fp64, fp64) -> fp64
        %scalar_div = tensor.OP_SCALAR_DIV %scalar_sub, %const_2 : (fp64, fp64) -> fp64
    }
    statement.return %scalar_div
  }
  // func.kind = control_flow
}
