# Example 8: Unary Operations
# Demonstrates various unary operations
program.module @test_unary_ops {
  program.entry @test_unary
  attr arch = "PTOv2"
  attr enable_debug = true
  attr tile_default = { M=16, N=16, K=16 }
  func.func @test_unary(%input: tensor<[%b_1, 128], fp32>, %output: tensor<[%b_1, 128], fp32>) {
    statement.op {
        # Unary operations
        %neg_res = tensor.neg %input : (tensor<[%b_1, 128], fp32>) -> tensor<[%b_1, 128], fp32>
        %abs_res = tensor.abs %neg_res : (tensor<[%b_1, 128], fp32>) -> tensor<[%b_1, 128], fp32>
        %exp_res = tensor.exp %abs_res : (tensor<[%b_1, 128], fp32>) -> tensor<[%b_1, 128], fp32>
        %sqrt_res = tensor.sqrt %exp_res : (tensor<[%b_1, 128], fp32>) -> tensor<[%b_1, 128], fp32>
        %ln_res = tensor.ln %sqrt_res : (tensor<[%b_1, 128], fp32>) -> tensor<[%b_1, 128], fp32>
        
        # Assemble result
        %output_result = tensor.assemble %ln_res, %output : (tensor<[%b_1, 128], fp32>, tensor<[%b_1, 128], fp32>) -> tensor<[%b_1, 128], fp32> {offset=[0, 0]}
    }
    statement.return
  }
  // func.kind = control_flow
}
