# Example 4: If Statement
# Based on docs/ir/ir_statement.md IfStatement section
program.module @main {
  program.entry @test_if_statement
  attr arch = "PTOv2"
  attr enable_debug = true
  attr tile_default = { M=16, N=16, K=16 }
  func.func @test_if_statement(%input_x: tensor<[%b_1, 128], fp32>, %input_y: tensor<[%b_1, 128], fp32>, %scale1: fp32, %scale2: fp32, %cond: bool, %output: tensor<[%b_1, 128], fp32>) {
    %r0 = statement.if %cond
    {
        // then-region statements
        statement.op {
            %res_then = tensor.mul %input_x, %scale1 : (tensor<[%b_1, 128], fp32>, %scale1) -> tensor<[%b_1, 128], fp32>
        }
        statement.yield %res_then
    } else {
        // else-region statements
        statement.op {
            %res_else = tensor.mul %input_y, %scale2 : (tensor<[%b_1, 128], fp32>, %scale2) -> tensor<[%b_1, 128], fp32>
        }
        statement.yield %res_else
    }
    statement.op {
        %output_result = tensor.assemble %r0, %output : (tensor<[%b_1, 128], fp32>, tensor<[%b_1, 128], fp32>) -> tensor<[%b_1, 128], fp32> {offset=[0, 0]}
    }
    statement.return
  }
  // func.kind = control_flow
}
