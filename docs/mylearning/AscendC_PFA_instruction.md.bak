## VF 指令流程与内存管理

### 昇腾 AI Core 架构回顾

```mermaid
graph TB
    subgraph "AI Core 架构"
        GM[Global Memory<br/>HBM]
        UB[Unified Buffer<br/>~1.5 MB]
        L1[L1 Buffer<br/>~1 MB]
        L0A[L0A Buffer<br/>64 KB]
        L0B[L0B Buffer<br/>64 KB]
        L0C[L0C Buffer<br/>128 KB]
        
        VF[Vector Facility<br/>向量计算单元]
        CU[Cube Unit<br/>矩阵计算单元]
        
        GM -->|DataCopy| UB
        GM -->|DataCopy| L1
        UB --> VF
        L1 -->|Load2L0| L0A
        L1 -->|Load2L0| L0B
        L0A --> CU
        L0B --> CU
        CU -->|Store| L0C
        L0C -->|DataCopy| UB
        UB -->|DataCopy| GM
    end
```

### Flash Attention 计算流程

#### 标准 Flash Attention (无优化)

```python
# 伪代码
for b in range(B):
    for n in range(N):
        for i in range(S_q // B_Q):      # Query blocks
            for j in range(S_kv // B_KV):  # KV blocks
                # Step 1: Q @ K^T (Cube Unit)
                Q_block = load_Q(b, n, i*B_Q:(i+1)*B_Q, :)    # [B_Q, D]
                K_block = load_K(b, n, j*B_KV:(j+1)*B_KV, :)  # [B_KV, D]
                S_ij = matmul(Q_block, K_block.T)             # [B_Q, B_KV]
                
                # Step 2: Scale
                S_ij_scaled = S_ij / sqrt(D)
                
                # Step 3: Apply mask (if causal)
                if causal:
                    S_ij_scaled = apply_causal_mask(S_ij_scaled)
                
                # Step 4: Softmax (Vector Facility)
                P_ij = softmax(S_ij_scaled)  # [B_Q, B_KV]
                
                # Step 5: P @ V (Cube Unit)
                V_block = load_V(b, n, j*B_KV:(j+1)*B_KV, :)  # [B_KV, D]
                O_ij = matmul(P_ij, V_block)                  # [B_Q, D]
                
                # Step 6: Accumulate output
                O[b, n, i*B_Q:(i+1)*B_Q, :] += O_ij
```

**问题**: 需要存储完整的注意力矩阵 P ∈ [S_q, S_kv]，内存占用大

#### Online Softmax Flash Attention

**核心思想**: 分块计算 softmax，使用 **Online Softmax** 算法累积结果

**Online Softmax 数学原理**：

给定两个向量块 $x_1, x_2$，如何计算 $\text{softmax}([x_1, x_2])$？

$$
\begin{align}
m_{\text{new}} &= \max(m_1, m_2) \\
d_{\text{new}} &= d_1 \cdot e^{m_1 - m_{\text{new}}} + d_2 \cdot e^{m_2 - m_{\text{new}}} \\
O_{\text{new}} &= O_1 \cdot \frac{d_1 \cdot e^{m_1 - m_{\text{new}}}}{d_{\text{new}}} + O_2 \cdot \frac{d_2 \cdot e^{m_2 - m_{\text{new}}}}{d_{\text{new}}}
\end{align}
$$

其中：
- $m_i = \max(x_i)$: 第 i 块的最大值
- $d_i = \sum e^{x_i - m_i}$: 第 i 块的指数和
- $O_i = \text{softmax}(x_i) \cdot V_i$: 第 i 块的输出

**代码实现**（来自 `flash_attention.py` golden）：

```python
def flash_attention_online_softmax(q, k, v, B_Q=128, B_KV=128):
    """Online Softmax Flash Attention 实现"""
    B, N, S_q, D = q.shape
    S_kv = k.shape[2]
    
    # 初始化
    O = np.zeros([B, N, S_q, D], dtype=np.float32)
    m = np.full([B, N, S_q, 1], -np.inf, dtype=np.float32)  # max
    l = np.zeros([B, N, S_q, 1], dtype=np.float32)          # sum(exp)
    
    for b in range(B):
        for n in range(N):
            # 外层循环: KV blocks
            for j in range(S_kv // B_KV):
                k_j = k[b, n, j*B_KV:(j+1)*B_KV, :]  # [B_KV, D]
                v_j = v[b, n, j*B_KV:(j+1)*B_KV, :]  # [B_KV, D]
                
                # 内层循环: Query blocks
                for i in range(S_q // B_Q):
                    q_i = q[b, n, i*B_Q:(i+1)*B_Q, :]  # [B_Q, D]
                    
                    # Step 1: Q @ K^T
                    S_ij = np.matmul(q_i, k_j.T)       # [B_Q, B_KV]
                    
                    # Step 2: 当前块的 max 和 sum
                    m_ij = np.max(S_ij, axis=-1, keepdims=True)  # [B_Q, 1]
                    S_ij_shifted = S_ij - m_ij
                    P_ij = np.exp(S_ij_shifted)         # [B_Q, B_KV]
                    l_ij = np.sum(P_ij, axis=-1, keepdims=True)  # [B_Q, 1]
                    
                    # Step 3: 当前块的输出
                    O_ij = np.matmul(P_ij, v_j)         # [B_Q, D]
                    
                    # Step 4: Online Softmax 更新
                    m_old = m[b, n, i*B_Q:(i+1)*B_Q, :]
                    l_old = l[b, n, i*B_Q:(i+1)*B_Q, :]
                    O_old = O[b, n, i*B_Q:(i+1)*B_Q, :]
                    
                    # 更新 max
                    m_new = np.maximum(m_old, m_ij)
                    
                    # 更新 sum
                    l_new = (l_old * np.exp(m_old - m_new) + 
                             l_ij * np.exp(m_ij - m_new))
                    
                    # 更新输出
                    O_new = (O_old * l_old * np.exp(m_old - m_new) / l_new +
                             O_ij * l_ij * np.exp(m_ij - m_new) / l_new)
                    
                    # 写回
                    m[b, n, i*B_Q:(i+1)*B_Q, :] = m_new
                    l[b, n, i*B_Q:(i+1)*B_Q, :] = l_new
                    O[b, n, i*B_Q:(i+1)*B_Q, :] = O_new
    
    return O
```

### AscendC 实现的关键 API

#### 1. 数据搬运（Data Copy）

```cpp
// GM -> UB
auto copyParams = ub.GetShape();
DataCopy(ub, gm_tensor[b_offset * ub_size], copyParams);

// UB -> GM  
DataCopy(gm_tensor[b_offset * ub_size], ub, copyParams);

// L0C -> UB
DataCopy(ub, l0c, copyParams);

// L1 -> L0A/L0B (Load2L0)
Load2L0(l0a, l1_tensor[a_offset], copyParams);
Load2L0(l0b, l1_tensor[b_offset], copyParams);
```

#### 2. 矩阵乘法（Cube Unit）

```cpp
// MMAD: Matrix Multiply and Accumulate with D-type
// 计算: L0C = L0A @ L0B + L0C
MMAD(l0c, l0a, l0b, mmadParams);

// QK^T: [B_Q, D] @ [D, B_KV] = [B_Q, B_KV]
// PV:   [B_Q, B_KV] @ [B_KV, D] = [B_Q, D]
```

#### 3. 向量计算（Vector Facility）

```cpp
// Softmax 计算
// Step 1: Max reduction
ReduceMax(max_val, input_tensor, reduceParams);

// Step 2: Sub + Exp
Sub(input_shifted, input_tensor, max_val);
Exp(exp_result, input_shifted);

// Step 3: Sum reduction
ReduceSum(sum_val, exp_result, reduceParams);

// Step 4: Div
Div(output, exp_result, sum_val);
```

#### 4. Online Softmax 更新

```cpp
// 更新 max: m_new = max(m_old, m_ij)
Max(m_new, m_old, m_ij);

// 更新 sum: l_new = l_old * exp(m_old - m_new) + l_ij * exp(m_ij - m_new)
Sub(delta_old, m_old, m_new);
Exp(scale_old, delta_old);
Mul(l_old_scaled, l_old, scale_old);

Sub(delta_ij, m_ij, m_new);
Exp(scale_ij, delta_ij);
Mul(l_ij_scaled, l_ij, scale_ij);

Add(l_new, l_old_scaled, l_ij_scaled);

// 更新 output: O_new = (O_old * l_old * scale_old + O_ij * l_ij * scale_ij) / l_new
Mul(O_old_scaled, O_old, l_old_scaled);
Mul(O_ij_scaled, O_ij, l_ij_scaled);
Add(O_new_unnorm, O_old_scaled, O_ij_scaled);
Div(O_new, O_new_unnorm, l_new);
```

### 内存管理策略

#### Buffer 分配策略

```cpp
// attn_infra/arch/resource.hpp
struct AttentionResource {
    // UB 分配
    LocalTensor<float> q_in_ub;      // Query block [B_Q, D]
    LocalTensor<float> k_in_ub;      // Key block [B_KV, D]
    LocalTensor<float> v_in_ub;      // Value block [B_KV, D]
    LocalTensor<float> s_in_ub;      // Score [B_Q, B_KV]
    LocalTensor<float> p_in_ub;      // Probability [B_Q, B_KV]
    LocalTensor<float> o_in_ub;      // Output [B_Q, D]
    
    // 中间变量
    LocalTensor<float> max_val;      // [B_Q, 1]
    LocalTensor<float> sum_val;      // [B_Q, 1]
    LocalTensor<float> scale_old;    // [B_Q, 1]
    LocalTensor<float> scale_ij;     // [B_Q, 1]
    
    // L1 分配（可选，用于双缓冲）
    LocalTensor<float> q_l1;
    LocalTensor<float> k_l1;
    LocalTensor<float> v_l1;
};
```

#### 内存复用技巧

**Double Buffering（双缓冲）**：

```cpp
// UB 分成两半：Ping-Pong Buffer
// 当计算 Ping buffer 时，预取数据到 Pong buffer
LocalTensor<float> ub_ping = ub[0 : ub_size/2];
LocalTensor<float> ub_pong = ub[ub_size/2 : ub_size];

// Loop 0: 计算 Ping，加载 Pong
Compute(ub_ping);
DataCopy(ub_pong, gm_next_block);

// Loop 1: 计算 Pong，加载 Ping
Compute(ub_pong);
DataCopy(ub_ping, gm_next_block);
```

---

## Shape 泛化机制

### 动态 Shape 支持

PFA 支持多种动态 Shape 场景：

1. **动态 Batch Size**: 推理时 batch 可能变化
2. **动态序列长度**: Prompt 长度不一
3. **动态 KV Cache 长度**: 增量推理时 KV 逐渐增长

#### 实现机制

**1. Tiling 时计算**（Host 侧）

```cpp
// op_host/fused_infer_attention_score_tiling.cpp
graphStatus CalculateTiling(gert::TilingContext *context) {
    // 获取运行时 shape
    auto query_shape = context->GetInputShape(0)->GetStorageShape();
    int64_t B = query_shape.GetDim(0);
    int64_t N = query_shape.GetDim(1);
    int64_t S_q = query_shape.GetDim(2);
    int64_t D = query_shape.GetDim(3);
    
    // 动态计算 tiling 参数
    uint32_t B_Q = CalculateQueryTileSize(S_q, D, ub_size);
    uint32_t B_KV = CalculateKVTileSize(S_kv, D, ub_size);
    
    // 保存到 tiling data
    tiling.set_querySeqTileSize(B_Q);
    tiling.set_kvSeqTileSize(B_KV);
    tiling.set_querySeqLoop((S_q + B_Q - 1) / B_Q);
    tiling.set_kvSeqLoop((S_kv + B_KV - 1) / B_KV);
}
```

**2. Kernel 时执行**（Device 侧）

```cpp
// op_kernel/fused_infer_attention_score.cpp
__aicore__ inline void Process() {
    // 从 tiling data 读取动态参数
    uint32_t B_Q = tilingData.get_querySeqTileSize();
    uint32_t B_KV = tilingData.get_kvSeqTileSize();
    uint32_t query_loop = tilingData.get_querySeqLoop();
    uint32_t kv_loop = tilingData.get_kvSeqLoop();
    
    // 动态循环
    for (uint32_t i = 0; i < query_loop; i++) {
        for (uint32_t j = 0; j < kv_loop; j++) {
            ProcessOneTile(i, j, B_Q, B_KV);
        }
    }
}

__aicore__ inline void ProcessOneTile(
    uint32_t query_idx, uint32_t kv_idx, 
    uint32_t B_Q, uint32_t B_KV
) {
    // 计算当前 tile 的实际大小（处理边界）
    uint32_t actual_B_Q = min(B_Q, S_q - query_idx * B_Q);
    uint32_t actual_B_KV = min(B_KV, S_kv - kv_idx * B_KV);
    
    // 加载实际大小的数据
    LoadQBlock(query_idx * B_Q, actual_B_Q);
    LoadKBlock(kv_idx * B_KV, actual_B_KV);
    
    // 计算并处理边界
    ComputeAttention(actual_B_Q, actual_B_KV);
}
```

### 多头注意力处理（GQA）

**GQA (Grouped Query Attention)** 场景：

```
Query Heads: N_q = 32
KV Heads:    N_kv = 8
Group Size:  N_q / N_kv = 4  (每4个query头共享1组KV)
```

**实现逻辑**：

```cpp
__aicore__ inline void ProcessGQA() {
    uint32_t N_q = query_shape[1];
    uint32_t N_kv = key_shape[1];
    uint32_t group_size = N_q / N_kv;
    
    for (uint32_t kv_head = 0; kv_head < N_kv; kv_head++) {
        // 加载一组 KV（复用 group_size 次）
        LoadKVHead(kv_head);
        
        // 该组 KV 对应的所有 query 头
        for (uint32_t q_in_group = 0; q_in_group < group_size; q_in_group++) {
            uint32_t q_head = kv_head * group_size + q_in_group;
            
            // 加载 query 头
            LoadQueryHead(q_head);
            
            // 计算注意力（复用 KV）
            ComputeAttentionWithSharedKV();
        }
    }
}
```

**内存优化**: KV 只需加载一次，被多个 query 头复用

### Paged Attention 支持

**Paged Attention** 用于高效管理 KV Cache：

```cpp
// Block Table 结构
struct BlockTable {
    int32_t* block_ids;     // [max_seq_len / block_size]
    int32_t block_size;     // 每个块包含的 token 数量
    int32_t num_blocks;     // 总块数
};

// 示例
batch = 0:
  block_ids = [5, 12, 3, 8, ...]  // 该序列使用的物理块 ID
  block_size = 16                  // 每个块存储 16 个 token 的 KV
  
// KV Cache 存储（物理布局）
KV Cache: [num_blocks, 2, N_kv, block_size, D]
         [block_id, K/V, head, tokens_in_block, dim]
```

**实现逻辑**：

```cpp
__aicore__ inline void LoadKVFromPageTable(
    int32_t* block_table, 
    int32_t seq_len,
    int32_t block_size
) {
    int32_t num_blocks = (seq_len + block_size - 1) / block_size;
    
    for (int32_t block_idx = 0; block_idx < num_blocks; block_idx++) {
        // 查询页表，获取物理块 ID
        int32_t physical_block_id = block_table[block_idx];
        
        // 计算该块处理的 token 数量（处理边界）
        int32_t tokens_in_block = min(
            block_size, 
            seq_len - block_idx * block_size
        );
        
        // 从物理地址加载 KV
        // GM offset: physical_block_id * block_size * N_kv * D
        LoadKVBlock(physical_block_id, tokens_in_block);
    }
}
```

**优势**:
1. **内存高效**: 不连续序列无需连续存储，减少内存碎片
2. **灵活管理**: 可以动态分配和释放块
3. **支持前缀缓存**: 相同前缀的序列可共享 KV Cache

---

## 核心特性实现

### 1. 因果注意力（Causal Attention）

**用途**: 仅关注当前位置之前的 token（自回归生成）

**实现方式 1**: Attention Mask

```cpp
// 生成因果掩码
// mask[i, j] = 0 if j <= i, else -inf
__aicore__ inline void ApplyCausalMask(
    LocalTensor<float> scores,
    int32_t query_start,
    int32_t kv_start,
    int32_t B_Q,
    int32_t B_KV
) {
    for (int i = 0; i < B_Q; i++) {
        for (int j = 0; j < B_KV; j++) {
            int32_t q_pos = query_start + i;
            int32_t k_pos = kv_start + j;
            
            if (k_pos > q_pos) {
                // 未来位置，设置为 -inf
                scores[i * B_KV + j] = -INFINITY;
            }
        }
    }
}
```

**实现方式 2**: 直接跳过计算（更高效）

```cpp
__aicore__ inline void ComputeCausalAttention(
    int32_t query_idx,
    int32_t kv_idx,
    int32_t B_Q,
    int32_t B_KV
) {
    int32_t query_start = query_idx * B_Q;
    int32_t kv_start = kv_idx * B_KV;
    
    // 如果整个块都在因果范围外，跳过
    if (kv_start > query_start + B_Q) {
        return;  // 不计算
    }
    
    // 计算实际有效的 KV 长度
    int32_t valid_kv_len = min(B_KV, query_start + B_Q - kv_start);
    
    if (valid_kv_len <= 0) {
        return;
    }
    
    // 只计算有效部分
    LoadQBlock(query_start, B_Q);
    LoadKBlock(kv_start, valid_kv_len);
    ComputeAttention(B_Q, valid_kv_len);
}
```

### 2. RoPE (Rotary Position Embedding)

**数学公式**:

$$
\begin{align}
\text{RoPE}(x, pos) &= \begin{pmatrix} x_1 \\ x_2 \\ x_3 \\ x_4 \\ \vdots \end{pmatrix} \odot 
\begin{pmatrix} \cos(pos \cdot \theta_1) \\ \cos(pos \cdot \theta_1) \\ \cos(pos \cdot \theta_2) \\ \cos(pos \cdot \theta_2) \\ \vdots \end{pmatrix} \\
&+ \begin{pmatrix} -x_2 \\ x_1 \\ -x_4 \\ x_3 \\ \vdots \end{pmatrix} \odot
\begin{pmatrix} \sin(pos \cdot \theta_1) \\ \sin(pos \cdot \theta_1) \\ \sin(pos \cdot \theta_2) \\ \sin(pos \cdot \theta_2) \\ \vdots \end{pmatrix}
\end{align}
$$

其中 $\theta_i = 10000^{-2i/D}$

**实现逻辑**:

```cpp
__aicore__ inline void ApplyRoPE(
    LocalTensor<float> query,      // [B_Q, D]
    LocalTensor<float> query_rope, // RoPE 编码 [B_Q, D/2]
    int32_t start_pos,
    int32_t B_Q,
    int32_t D
) {
    for (int i = 0; i < B_Q; i++) {
        int32_t pos = start_pos + i;
        
        for (int j = 0; j < D/2; j++) {
            float theta = pow(10000.0, -2.0 * j / D);
            float angle = pos * theta;
            float cos_val = cos(angle);
            float sin_val = sin(angle);
            
            float x1 = query[i * D + 2*j];
            float x2 = query[i * D + 2*j + 1];
            
            // 应用旋转
            query[i * D + 2*j] = x1 * cos_val - x2 * sin_val;
            query[i * D + 2*j + 1] = x1 * sin_val + x2 * cos_val;
        }
    }
}
```

**优化**: RoPE 编码预计算并缓存

```cpp
// Host 侧预计算
void PrecomputeRoPE(int32_t max_seq_len, int32_t D) {
    for (int pos = 0; pos < max_seq_len; pos++) {
        for (int j = 0; j < D/2; j++) {
            float theta = pow(10000.0, -2.0 * j / D);
            float angle = pos * theta;
            rope_cache[pos * D + 2*j] = cos(angle);
            rope_cache[pos * D + 2*j + 1] = sin(angle);
        }
    }
}

// Device 侧查表
__aicore__ inline void ApplyRoPEFromCache(
    LocalTensor<float> query,
    GlobalTensor<float> rope_cache,
    int32_t start_pos,
    int32_t B_Q,
    int32_t D
) {
    for (int i = 0; i < B_Q; i++) {
        int32_t pos = start_pos + i;
        
        for (int j = 0; j < D/2; j++) {
            float cos_val = rope_cache[pos * D + 2*j];
            float sin_val = rope_cache[pos * D + 2*j + 1];
            
            float x1 = query[i * D + 2*j];
            float x2 = query[i * D + 2*j + 1];
            
            query[i * D + 2*j] = x1 * cos_val - x2 * sin_val;
            query[i * D + 2*j + 1] = x1 * sin_val + x2 * cos_val;
        }
    }
}
```

### 3. INT8/INT4 量化支持

#### INT8 量化（KV Cache）

**量化公式**:

$$
\text{Quant}(x) = \text{clip}\left(\text{round}\left(\frac{x}{\text{scale}} + \text{offset}\right), -128, 127\right)
$$

$$
\text{Dequant}(x_{\text{int8}}) = (x_{\text{int8}} - \text{offset}) \times \text{scale}
$$

**实现流程**:

```cpp
// 1. 加载量化的 KV
__aicore__ inline void LoadQuantizedKV(
    GlobalTensor<int8_t> kv_int8,
    GlobalTensor<float> scale,
    GlobalTensor<float> offset,
    LocalTensor<float> kv_fp32,
    int32_t block_id,
    int32_t B_KV,
    int32_t D
) {
    // 加载 INT8 数据
    LocalTensor<int8_t> kv_int8_local = AllocTensor<int8_t>(B_KV * D);
    DataCopy(kv_int8_local, kv_int8[block_id * B_KV * D], B_KV * D);
    
    // 加载 scale 和 offset（per-tensor 或 per-channel）
    LocalTensor<float> scale_local = AllocTensor<float>(D);
    LocalTensor<float> offset_local = AllocTensor<float>(D);
    DataCopy(scale_local, scale, D);
    DataCopy(offset_local, offset, D);
    
    // 反量化
    for (int i = 0; i < B_KV; i++) {
        for (int j = 0; j < D; j++) {
            kv_fp32[i * D + j] = 
                (static_cast<float>(kv_int8_local[i * D + j]) - offset_local[j]) 
                * scale_local[j];
        }
    }
}

// 2. 计算注意力（使用反量化后的 FP32）
ComputeAttention(query_fp32, kv_fp32, value_fp32);
```

#### INT4 伪量化（Antiquant）

**应用场景**: DeepSeek 等大模型使用 INT4 存储权重，但计算时转换为 FP16

**实现**:

```cpp
__aicore__ inline void LoadINT4KV(
    GlobalTensor<int4> kv_int4,        // INT4 packed storage
    GlobalTensor<float> antiquant_scale,
    GlobalTensor<float> antiquant_offset,
    LocalTensor<float> kv_fp32,
    int32_t block_id,
    int32_t B_KV,
    int32_t D
) {
    // INT4 以 packed 形式存储（2个INT4打包成1个INT8）
    LocalTensor<uint8_t> kv_packed = AllocTensor<uint8_t>(B_KV * D / 2);
    DataCopy(kv_packed, kv_int4[block_id * B_KV * D / 2], B_KV * D / 2);
    
    // 解包 INT4
    LocalTensor<int4> kv_int4_local = AllocTensor<int4>(B_KV * D);
    UnpackINT4(kv_int4_local, kv_packed, B_KV * D);
    
    // 加载 antiquant 参数
    LocalTensor<float> scale_local = AllocTensor<float>(D);
    LocalTensor<float> offset_local = AllocTensor<float>(D);
    DataCopy(scale_local, antiquant_scale, D);
    DataCopy(offset_local, antiquant_offset, D);
    
    // 反量化
    for (int i = 0; i < B_KV; i++) {
        for (int j = 0; j < D; j++) {
            kv_fp32[i * D + j] = 
                (static_cast<float>(kv_int4_local[i * D + j]) - offset_local[j]) 
                * scale_local[j];
        }
    }
}
```

### 4. Shared Prefix（前缀共享）

**场景**: 多个序列共享相同的前缀（如 system prompt）

**实现**:

```cpp
struct SharedPrefixConfig {
    int32_t prefix_len;        // 共享前缀长度
    int32_t prefix_batch;      // 前缀所在的 batch id
    bool use_shared_prefix;    // 是否启用前缀共享
};

__aicore__ inline void ProcessSharedPrefix(
    LocalTensor<float> query,
    GlobalTensor<float> key,
    GlobalTensor<float> value,
    SharedPrefixConfig config
) {
    if (!config.use_shared_prefix) {
        return;
    }
    
    // 1. 计算与前缀的注意力
    LoadQBlock(query, 0, B_Q);
    
    // 共享前缀来自特定 batch
    LoadKVFromBatch(
        key, value, 
        config.prefix_batch, 
        0, config.prefix_len
    );
    
    ComputeAttentionWithPrefix();
    
    // 2. 继续计算与非前缀部分的注意力
    LoadKVFromBatch(
        key, value,
        current_batch,
        config.prefix_len, kv_len
    );
    
    ComputeAttentionWithOnlineSoftmax();
}
```

